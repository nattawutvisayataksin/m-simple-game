{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "pixellab-a": {
        "type": "remote",
        "url": "https://api.pixellab.ai/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:PIXELLAB_API_KEY_A}"
        }
      },
      "pixellab-b": {
        "type": "remote",
        "url": "https://api.pixellab.ai/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:PIXELLAB_API_KEY_B}"
        }
      },
      "pixellab-c": {
        "type": "remote",
        "url": "https://api.pixellab.ai/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:PIXELLAB_API_KEY_C}"
        }
      },
      "godot-mcp": {
        "type": "local",
        "command": ["npx", "-y", "@coding-solo/godot-mcp"],
        "environment": {
          "GODOT_PATH": "C:\\Users\\Administrator\\AppData\\Local\\Microsoft\\WinGet\\Packages\\GodotEngine.GodotEngine_Microsoft.Winget.Source_8wekyb3d8bbwe\\Godot_v4.7.2-stable_win64_console.exe"
        }
      }
    }
  }
}
